# Molink 环境变量配置
# 使用方法：复制本文件为 .env（docker compose 会自动读取同目录 .env），并修改其中的值
# 不创建 .env 时，本地开发可直接使用 docker-compose.yml 中的默认值一键启动

# 数据库配置
MYSQL_ROOT_PASSWORD=root_password
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_DATABASE=molink_db
MYSQL_USER=molink
MYSQL_PASSWORD=molink_password

# Redis 配置
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=molink_redis_dev

# 后端配置
# 必填：JWT/Session 签名密钥，生产环境必须替换为足够长的随机串
SECRET_KEY=dev-only-secret-do-not-use-in-prod
DEBUG=false

# 初始管理员（仅首次启动播种：账号不存在时创建；不设置 ADMIN_PASSWORD 则不创建）
# 生产环境务必修改或留空
ADMIN_EMAIL=admin@molink.local
ADMIN_PASSWORD=admin123
